    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/shriram2007721/Online-Exam.git'
            }
        }

        stage('Generate Report') {
            steps {
                bat '"C:\\Users\\shrir\\AppData\\Local\\Programs\\Python\\Python312\\python.exe" project2-test/app.py'
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts artifacts: 'report.txt', fingerprint: true
            }
        }
    }
}
